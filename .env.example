# ─────────────────────────────────────────────
#  GlobeGate configuration — copy to .env
#  Full reference: https://github.com/CorentinGrard/globegate#configuration
# ─────────────────────────────────────────────

# ── Your server (where arcs land) ──
SERVER_LAT=48.8566
SERVER_LON=2.3522
SERVER_LABEL=Paris, FR

# ── GeoIP (free account: https://www.maxmind.com/en/geolite2/signup) ──
# The database is downloaded at start and refreshed weekly.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# ── Privacy ──
# What viewers see: masked (203.0.113.x), full, or hidden
IP_DISPLAY=masked
# IPs / CIDR ranges to drop entirely, e.g. uptime monitors
IGNORE_IPS=
# Hide your own traffic coming back through the router: a DNS name pointing at
# your public IP (resolved every 5 min, follows IP changes)
IGNORE_HOSTS=
# HTTP path prefixes to drop, e.g. health checks: /health,/_health,/ping
IGNORE_PATHS=
# Days of history to keep
RETENTION_DAYS=7

# ── TCP/UDP connections (needs network_mode: host + NET_ADMIN, see compose.yaml) ──
# auto = on when available, true = required, false = off
CONNTRACK=auto
# Ports already covered by the Traefik log
CONNTRACK_IGNORE_PORTS=80,443
# Only show these ports (empty = all)
CONNTRACK_ONLY_PORTS=
# Show the same IP + port at most once per N seconds
CONNTRACK_DEDUPE_SECONDS=30
# Name services by port (22=ssh, 51820=wireguard… are built in)
CONNTRACK_PORT_NAMES=

# ── Misc ──
# Fake traffic: auto (only when no source is available), true, false
DEMO=auto
PORT=3000
# Listen only on this address. With network_mode: host behind a containerized
# reverse proxy, use the Docker bridge IP (ip -4 addr show docker0), e.g. 172.17.0.1
LISTEN_ADDRESS=
